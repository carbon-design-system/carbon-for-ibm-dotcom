{
  "compilerOptions": {
    "target": "es2017",
    "module": "es2020",
    "moduleResolution": "node",
    "lib": ["es2017", "esnext.array", "dom", "dom.iterable"],
    "typeRoots": [
      "src/typings",
      "tests/typings",
      "node_modules/@types",
      "../../node_modules/@types"
    ],
    "declaration": true,
    "rootDir": ".",
    "sourceMap": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "experimentalDecorators": true,
    // Keep false (not TEMP): class fields must compile to plain constructor assignments,
    // not Object.defineProperty, or they shadow Lit's prototype accessors and assignments
    // stop re-rendering. TS defaults this to true for target >= ES2022, so set it
    // explicitly. See https://lit.dev/docs/components/decorators/
    "useDefineForClassFields": false,
    "skipLibCheck": true,
    "strict": true,
    "stripInternal": true,
    "noImplicitAny": false,
    "jsx": "react",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx"
  ],
  "exclude": [
    "src/**/*.react.tsx",
    "src/**/*.stories.react.tsx",
    "src/components/table-of-contents/__stories__/wrapper-content.tsx",
    ".storybook/react/**/*"
  ]
}
